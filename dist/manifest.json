{
  "manifest_version": 3,
  "name": "Asguard — Nadine AI",
  "short_name": "Asguard",
  "description": "Chrome extension companion for Nadine — AI summaries, saved templates, mail-merge batch.",
  "version": "0.4.8",
  "key": "",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "action": {
    "default_title": "Asguard — buka panel"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/page-inject.ts-loader-E5K1ZHn0.js"
      ],
      "matches": [
        "https://satu.kemenkeu.go.id/*",
        "https://service.kemenkeu.go.id/*",
        "https://siman.kemenkeu.go.id/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "js": [
        "assets/index.ts-loader-CkyTb_vx.js"
      ],
      "matches": [
        "https://satu.kemenkeu.go.id/*",
        "https://service.kemenkeu.go.id/*",
        "https://siman.kemenkeu.go.id/*"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://satu.kemenkeu.go.id/*",
    "https://service.kemenkeu.go.id/*",
    "https://satu-notif.kemenkeu.go.id/*",
    "https://satu-file.kemenkeu.go.id/*",
    "https://siman.kemenkeu.go.id/*",
    "https://siman-svc.kemenkeu.go.id/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "https://vps.asetpattimura.my.id/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://satu.kemenkeu.go.id/*",
        "https://service.kemenkeu.go.id/*",
        "https://siman.kemenkeu.go.id/*"
      ],
      "resources": [
        "assets/logging-CJQJm_bn.js",
        "assets/page-inject.ts-M5GwwBZo.js",
        "assets/index.ts-CCZDDM8T.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
